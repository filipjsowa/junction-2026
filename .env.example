# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=swarm
DB_USER=swarm
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Embeddings API (assumed OpenAI-compatible: POST {EMBEDDINGS_BASE_URL}/embeddings)
EMBEDDINGS_BASE_URL=https://your-embeddings-api/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
EMBEDDING_DIM=1024

# Hostinger AI Router (OpenAI-compatible) for narratives and technique labels
AI_ROUTER_BASE_URL=
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=

# Scoring
MATCH_THRESHOLD=0.80

# Reviewer console (simple shared password for the demo)
REVIEWER_PASSWORD=change-me

# VPS only (Caddy): your domain for automatic HTTPS, or :80 to test over plain HTTP on the VPS IP
DOMAIN=:80
# VPS only (setup-vps.sh adds this): every docker compose / make command then uses the prod setup
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
